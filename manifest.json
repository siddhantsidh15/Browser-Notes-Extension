{
  "manifest_version": 3,
  "name": "Save to Notes",
  "version": "2.4.0",
  "description": "Select any text on a webpage, right-click, and save it to your notes. Click the extension icon to view all notes.",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "Command+M",
        "default": "Ctrl+M"
      },
      "description": "Open Save to Notes popup"
    },
    "take-snapshot": {
      "suggested_key": {
        "mac": "Command+Shift+S",
        "default": "Ctrl+Shift+S"
      },
      "description": "Insert a snapshot of the current page into the notepad"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
